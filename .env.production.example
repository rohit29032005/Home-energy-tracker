# Production Environment Variables Example
# Copy this file to .env on your Azure VM before running: docker compose -f docker-compose.prod.yml up -d

# MySQL Production Credentials
MYSQL_ROOT_PASSWORD=ChangeThisToASecureProductionPassword123!
MYSQL_DATABASE=home_energy_tracker
MYSQL_USER=hometracker_app
MYSQL_PASSWORD=ChangeThisToASecureApplicationPassword123!

# InfluxDB Production Configuration
INFLUX_USER=admin
INFLUX_PASSWORD=ChangeThisToASecureInfluxPassword123!
INFLUX_ORG=hometracker
INFLUX_BUCKET=usage-bucket
INFLUX_TOKEN=GenerateASecureRandom64CharTokenForInfluxDBInProduction1234567890==

# Mailpit & Alert Service
MAIL_HOST=mailpit
MAIL_PORT=1025

# Keep automated load generation off in production. Real meters or the
# dashboard simulator should be the source of readings.
SIMULATION_ENABLED=false
SIMULATION_REQUESTS_PER_INTERVAL=10
SIMULATION_INTERVAL_MS=60000
SIMULATION_PARALLEL_THREADS=1

# Domain / Public Host Configuration
DOMAIN_NAME=energy-tracker.yourdomain.com

# Production identity / device-ingestion configuration
# Use a TLS-protected Keycloak deployment or managed OIDC provider. Do not use
# the local development Keycloak admin or demo accounts in production.
SECURITY_ENABLED=true
KEYCLOAK_ISSUER_URI=https://keycloak.yourdomain.com/realms/home-energy
KEYCLOAK_JWK_SET_URI=https://keycloak.yourdomain.com/realms/home-energy/protocol/openid-connect/certs
WOKWI_INGESTION_TOKEN=GenerateAStrongRandomDeviceTokenForProduction
# Required secure-ingestion configuration. Use distinct high-entropy secrets;
# do not reuse the Wokwi device token as the private gateway proof.
INGESTION_AUTH_REQUIRED=true
IOT_INGESTION_DEVICE_TOKENS=1:GenerateADeviceOneSpecificRandomToken
# Identifies requests forwarded by api-gateway. It is provided only to
# api-gateway, ingestion-service, and every gateway-protected downstream API
# service; never use it as a frontend, browser, or Wokwi credential.
INTERNAL_GATEWAY_TOKEN=GenerateASeparateHighEntropyGatewayToIngestionToken
# Used by usage-service and alert-service for read-only user/device context
# lookups and by insight-service for read-only usage lookups. Keep it distinct
# from INTERNAL_GATEWAY_TOKEN and do not use it for public or write requests.
INTERNAL_SERVICE_TOKEN=GenerateASeparateHighEntropyInternalServiceToken
ALERT_DEDUPLICATION_ENABLED=true
ALERT_DEDUPLICATION_WINDOW_MINUTES=15
KAFKA_MAX_PROCESSING_ATTEMPTS=3
