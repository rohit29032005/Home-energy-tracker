# Development fallback for a locally verified Maven artifact.  The standard
# Dockerfile remains the source-build path; this file avoids a transient
# Docker-builder DNS outage when redeploying a tested local change.
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY target/api-gateway-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
