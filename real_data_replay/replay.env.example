# Copy to replay.env, set an actual local token, and keep the copied file private.
# The replay tool does not read the repository .env automatically.

# Existing public gateway route, verified from api-gateway configuration.
REPLAY_ENDPOINT=http://localhost:8080/api/v1/ingestion

# Set this to the actual local WOKWI_INGESTION_TOKEN value. Do not commit it.
REPLAY_DEVICE_TOKEN=replace-with-your-local-device-token

# Paths in this file are resolved relative to the location of replay.env.
REPLAY_INPUT=../data/refit/processed/cleaned_dataset.csv
REPLAY_DEVICE_MAP_FILE=device-map.json
REPLAY_OUTPUT_DIR=logs

# current: payload timestamp is generated at send time during --execute.
# rebased: source-relative time is anchored at REPLAY_START_UTC (not compressed by --speed).
# source: payload retains recorded 2014/2015 source timestamps.
REPLAY_TIMESTAMP_MODE=current

# relative aligns each selected household window to t=0 for concurrent replay.
# source preserves cross-house source chronology, including the large 2014/2015 gap.
REPLAY_TIMELINE_MODE=relative

# Pacing controls. Speed changes wall-clock scheduling only; max rate can slow it further.
REPLAY_SPEED=100
REPLAY_MAX_EVENTS_PER_SECOND=5
REPLAY_TIMEOUT_SECONDS=10
REPLAY_MAX_ATTEMPTS=3
REPLAY_BACKOFF_SECONDS=1
REPLAY_PROGRESS_EVERY=1000
