# Template only. Copy this outside the repository, generate fresh values, and
# restrict the resulting file to the experiment operator and SYSTEM. Never put
# a real credential, token, password, or device mapping in this repository.
REFIT2_MYSQL_ROOT_PASSWORD=<GENERATE_FRESH_SECRET>
REFIT2_MYSQL_DATABASE=refit_step2
REFIT2_MYSQL_APP_USER=refit_step2_app
REFIT2_MYSQL_APP_PASSWORD=<GENERATE_FRESH_SECRET>
REFIT2_INTERNAL_GATEWAY_TOKEN=<GENERATE_FRESH_SECRET>
REFIT2_INTERNAL_SERVICE_TOKEN=<GENERATE_FRESH_SECRET>
REFIT2_KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=refit_step2_platform_admin
REFIT2_KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=<GENERATE_FRESH_SECRET>
REFIT2_KEYCLOAK_HOST_PORT=18081
REFIT2_GATEWAY_HOST_PORT=18080
REFIT2_MAILPIT_HOST_PORT=18025
REFIT2_REALM=refit-experiment
REFIT2_PROVISIONING_ADMIN_USERNAME=refit_step2_provisioner
REFIT2_PROVISIONING_ADMIN_PASSWORD=<GENERATE_FRESH_SECRET>
REFIT2_PROVISIONING_CLIENT_ID=refit_step2_provisioning_cli
REFIT2_PROVISIONING_CLIENT_SECRET=<GENERATE_FRESH_SECRET>
REFIT2_INFLUX_ADMIN_USERNAME=refit_step2_influx_admin
REFIT2_INFLUX_ADMIN_PASSWORD=<GENERATE_FRESH_SECRET>
REFIT2_INFLUX_ADMIN_TOKEN=<GENERATE_FRESH_SECRET>
REFIT2_INFLUX_ORG=refit_step2
REFIT2_INFLUX_BUCKET=refit_step2_usage
# Leave empty during provisioning. Fill only after the three database-generated
# device IDs have been verified and unique device-bound secrets have been made.
REFIT2_IOT_INGESTION_DEVICE_TOKENS=
