# Task 4C REFIT experiment runtime configuration template.
#
# This file contains placeholders only. Copy it to an untracked local `.env`
# file only after explicit deployment approval. Never place production,
# development, Wokwi, Keycloak administrator, or existing device credentials
# here.

# Non-secret, experiment-specific names. Do not point these at the current
# home_energy_tracker database or usage-bucket resources.
REFIT_GATEWAY_HOST_PORT=18080
REFIT_MYSQL_DATABASE=refit_experiment
REFIT_MYSQL_APP_USER=refit_experiment_app
REFIT_INFLUX_ADMIN_USERNAME=refit_experiment_admin
REFIT_INFLUX_ORG=refit_experiment
REFIT_INFLUX_BUCKET=refit_experiment_usage

# Runtime secrets: intentionally blank placeholders.
REFIT_MYSQL_ROOT_PASSWORD=
REFIT_MYSQL_APP_PASSWORD=
REFIT_INFLUX_ADMIN_PASSWORD=
REFIT_INFLUX_ADMIN_TOKEN=
REFIT_INTERNAL_GATEWAY_TOKEN=
REFIT_INTERNAL_SERVICE_TOKEN=

# Secure identity provider: required, but not supplied by the eight-service
# Task 4C composition. Values must reference an approved isolated OIDC/Keycloak
# deployment, never the existing development issuer or Docker `keycloak` host.
REFIT_KEYCLOAK_ISSUER_URI=
REFIT_KEYCLOAK_JWK_SET_URI=

# Leave blank until three approved experiment devices exist. The only allowed
# runtime structure is:
# <H1_DEVICE_ID>:<H1_TOKEN>,<H2_DEVICE_ID>:<H2_TOKEN>,<H4_DEVICE_ID>:<H4_TOKEN>
REFIT_IOT_INGESTION_DEVICE_TOKENS=
