# Frontend authentication is enabled by default. Set this to false only when
# intentionally running the offline fallback preview with no backend.
VITE_AUTH_ENABLED=true

# The local Docker Compose Keycloak realm defaults are safe to keep implicit,
# but these values are provided for an explicit local override.
VITE_KEYCLOAK_BASE_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=home-energy
VITE_KEYCLOAK_CLIENT_ID=home-energy-dashboard
