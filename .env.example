# Local development values only. Copy this file to .env; never use these values
# in production or commit the copied .env file.

# MySQL Configuration
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_DATABASE=home_energy_tracker
MYSQL_USER=hometracker_app
MYSQL_PASSWORD=hometracker_local_password

# Kafka Configuration
KAFKA_CLUSTER_ID=energy-tracker-cluster-1

# InfluxDB Configuration
INFLUX_USER=admin
INFLUX_URL=http://localhost:8072
INFLUX_TOKEN=local-influx-admin-token
INFLUX_ORG=hometracker
INFLUX_BUCKET=usage-bucket
INFLUX_PASSWORD=local_influx_password

# Local Keycloak and Wokwi machine-identity values. These are development-only
# placeholders and must be replaced for any non-local deployment.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local_keycloak_admin_password
SECURITY_ENABLED=true
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/home-energy
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/home-energy/protocol/openid-connect/certs
WOKWI_INGESTION_TOKEN=local-wokwi-ingestion-token-change-me
# Local proof that identifies the API gateway as a trusted private caller.
# Docker Compose provides it to api-gateway, ingestion-service, and every
# gateway-protected downstream API service. It is not a browser, frontend, or
# Wokwi device token.
# Use a unique secret for any non-local deployment.
INTERNAL_GATEWAY_TOKEN=local-gateway-to-ingestion-token-change-me
# Separate credential for background usage-service and alert-service read-only
# user/device lookups, and insight-service read-only usage lookups. The target
# services validate it; it must not be used as the gateway proof or as a
# browser/Wokwi credential.
INTERNAL_SERVICE_TOKEN=local-internal-service-token-change-me
# Explicit device binding for local Wokwi/simulator device 1.
INGESTION_AUTH_REQUIRED=true
IOT_INGESTION_DEVICE_TOKENS=1:local-wokwi-ingestion-token-change-me
ALERT_DEDUPLICATION_ENABLED=true
ALERT_DEDUPLICATION_WINDOW_MINUTES=15
KAFKA_MAX_PROCESSING_ATTEMPTS=3
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_grafana_admin_password

# Automatic load simulation is intentionally disabled. Use the dashboard's
# simulator tab to publish a reading, or explicitly set this to true.
SIMULATION_ENABLED=false
SIMULATION_REQUESTS_PER_INTERVAL=10
SIMULATION_INTERVAL_MS=60000
SIMULATION_PARALLEL_THREADS=1
